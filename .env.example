# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Your server's ID (right-click server > Copy Server ID, with Developer Mode on)
DISCORD_GUILD_ID=your-server-id

# --- Roblox (https://create.roblox.com/dashboard/credentials) ---
# API key needs: universe.place.luau-execution-session:write  (for /playtest)
ROBLOX_API_KEY=your-open-cloud-key
ROBLOX_UNIVERSE_ID=1234567890
ROBLOX_PLACE_ID=1234567890

# --- Optional ---
# How often (minutes) the bot runs an automatic playtest and posts it to #bot-reports. 0 = off
AUTO_TEST_INTERVAL_MIN=0
# Comma-separated extra words for automod to delete
BLOCKED_WORDS=
